# Copier ce fichier en .env puis renseigner vos valeurs. Ne jamais commiter .env.

# --- LLM (obligatoire) ---
MISTRAL_API_KEY=
MODEL_NAME=mistral-small-latest

# --- Envoi d'e-mails de refus (optionnel, via MCP Resend) ---
RESEND_API_KEY=
RESEND_SENDER_EMAIL=onboarding@resend.dev
RESEND_MCP_URL=https://mcp.resend.com/mcp

# --- Recherche d'offres pour les étudiants (optionnel) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- OCR de secours pour CV scannés (optionnel) ---
# Option A : API compatible OpenAI (ex. Groq). Option B : vLLM local (http://localhost:8001/v1/chat/completions)
QWEN_VLM_URL=http://localhost:8001/v1/chat/completions
QWEN_VLM_API_KEY=
QWEN_VLM_MODEL=Qwen2.5-VL-7B-Instruct
QWEN_VLM_TIMEOUT_SECONDS=60

# --- Comptes de démo créés au premier lancement ---
# Si laissés vides, des mots de passe aléatoires sont générés et affichés une fois dans la console.
DEMO_RECRUITER_PASSWORD=
DEMO_STUDENT_PASSWORD=
